# MongoDB Atlas connection string. Create a database user with least-privilege access.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wingo_intelligence

# Reference endpoints found in the provided example HTML. Verify authorization and availability.
WINGO_HISTORY_URL=https://draw.ar-lottery01.com/WinGo/WinGo_30S/GetHistoryIssuePage.json
WINGO_GAME_MODE=WinGo_30S

# Collector cadence: 30 seconds for the 30S game. Avoid aggressive polling.
COLLECT_INTERVAL_MS=30000
TIME_ZONE=Asia/Kolkata
